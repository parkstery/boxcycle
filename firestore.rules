rules_version = '2';
// 배포: firebase deploy --only firestore  (프로젝트는 firebase use 또는 .firebaserc)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function publicationPath(publicationId) {
      return /databases/$(database)/documents/routePublications/$(publicationId);
    }

    /** 동행 세션 — `routePublications` published 또는 presenceEnabled */
    function isPublicationSharedPresenceAllowed(publicationId) {
      return exists(publicationPath(publicationId))
        && (
          (get(publicationPath(publicationId)).data.keys().hasAny(['presenceEnabled'])
            && get(publicationPath(publicationId)).data.presenceEnabled == true)
          || (get(publicationPath(publicationId)).data.keys().hasAny(['status'])
            && get(publicationPath(publicationId)).data.status == 'published')
        );
    }

    /** Firebase Console 에 `config/routeReviewers` 문서 `{ uids: ["uid1", ...] }` 수동 등록 */
    function isRouteReviewer() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/routeReviewers)
        && request.auth.uid in get(/databases/$(database)/documents/config/routeReviewers).data.uids;
    }

    function experienceTagsValidPublicRequest() {
      let t = request.resource.data.experienceTags;
      return t is list
        && t.size() >= 1
        && t.size() <= 3
        && t.hasOnly(['mountain_trail', 'coastal_road', 'water_route', 'urban', 'countryside']);
    }

    function savedRouteOwnedAndCompletedForRequest(savedRouteId) {
      return exists(/databases/$(database)/documents/savedRoutes/$(savedRouteId))
        && get(/databases/$(database)/documents/savedRoutes/$(savedRouteId)).data.userId == request.auth.uid
        && get(/databases/$(database)/documents/savedRoutes/$(savedRouteId)).data.completed == 1;
    }

    /**
     * users 에 nickname / nicknameKey 가 들어가려면 nicknames/{key} 가
     * 같은 uid 로 예약되어 있어야 한다(클라이언트만으로 중복 우회 방지).
     */
    function userNicknameReserved() {
      return request.resource.data.keys().hasAll(['nickname', 'nicknameKey'])
        && request.resource.data.nicknameKey is string
        && request.resource.data.nicknameKey.matches('^[a-z][a-z0-9]{3,11}$')
        && exists(/databases/$(database)/documents/nicknames/$(request.resource.data.nicknameKey))
        && get(/databases/$(database)/documents/nicknames/$(request.resource.data.nicknameKey)).data.ownerUid == request.auth.uid;
    }

    function userNicknameChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname', 'nicknameKey']);
    }

    function userRouteTokenFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'routeTokenBalance',
        'routeTokenBalanceUpdatedAt',
        'routeTokenOnboardingGranted',
        'routeTokenEarnDayKey',
        'routeTokenEarnedToday'
      ]);
    }

    function userTierProtectedFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscriptionStatus',
        'subscriptionExpiresAt',
        'stripeCustomerId',
        'stripeSubscriptionId'
      ]);
    }

    function userTierOnCreateValid() {
      return !request.resource.data.keys().hasAny([
          'tier',
          'tierUpdatedAt',
          'subscriptionStatus',
          'subscriptionExpiresAt',
          'stripeCustomerId',
          'stripeSubscriptionId'
        ])
        || request.resource.data.tier == 'anonymous';
    }

    /** 닉네임 확정 시에만 registered_free 승격 허용 */
    function userTierUpdateValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['tier', 'tierUpdatedAt'])
        || (userNicknameChanged()
          && request.resource.data.tier == 'registered_free'
          && !changed.hasAny(['subscriptionStatus', 'subscriptionExpiresAt']));
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userTierAllowsPublicRoute() {
      return isSignedIn()
        && exists(userDocPath())
        && get(userDocPath()).data.tier in ['registered_free', 'registered_paid', 'admin'];
    }

    function trailInstanceDoc(trailId) {
      return /databases/$(database)/documents/trails/$(trailId);
    }

    function trailHasPublicationId(data) {
      return data.keys().hasAny(['publicationId'])
        && data.publicationId is string
        && data.publicationId.size() > 0;
    }

    /** 공개 Trail 은 publicationId 필수 — 비공개는 경로 없이 개설 가능(개설자 전용) */
    function trailOpenVisibilityValid(data) {
      return data.visibility != 'open' || trailHasPublicationId(data);
    }

    /**
     * Trail presence·livePublicationRides — Trailhead(`default`)·공개 Trail·비공개 Trail 개설자.
     * 비공개 Trail 타인 합류는 초대·승인 후속 — Rules 에서 차단.
     */
    function trailParticipantWriteAllowed(trailId) {
      return trailId == 'default'
        || (exists(trailInstanceDoc(trailId))
          && (
            get(trailInstanceDoc(trailId)).data.visibility == 'open'
            || get(trailInstanceDoc(trailId)).data.hostUid == request.auth.uid
          ));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSelf(userId)
        && (!request.resource.data.keys().hasAny(['nickname', 'nicknameKey']) || userNicknameReserved())
        && !request.resource.data.keys().hasAny([
          'routeTokenBalance',
          'routeTokenBalanceUpdatedAt',
          'routeTokenOnboardingGranted',
          'routeTokenEarnDayKey',
          'routeTokenEarnedToday'
        ])
        && userTierOnCreateValid();
      allow update: if isSelf(userId)
        && (!userNicknameChanged() || userNicknameReserved())
        && userRouteTokenFieldsUntouched()
        && userTierProtectedFieldsUntouched()
        && userTierUpdateValid();
      allow delete: if false;
    }

    /**
     * 전역 닉네임 예약(소문자 키). 문서 ID = normalizeNicknameKey(닉네임).
     * create 는 ownerUid 만 필수(hasOnly 는 SDK/필드 조합에서 거절되는 사례가 있어 완화).
     * list 는 막고 get 만 허용(무작위 열람 방지).
     */
    match /nicknames/{key} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid is string
        && request.resource.data.keys().hasAll(['ownerUid'])
        && key.matches('^[a-z][a-z0-9]{3,11}$');
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    /**
     * 전역 라이브 presence — lat/lng 만. publicationId·trail·geometry 불필요.
     * 로그인 사용자는 전원 읽기, 본인 문서만 쓰기.
     */
    match /livePresence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId)
        && request.resource.data.keys().hasAll(['lat', 'lng', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'updatedAt', 'displayName'])
        && request.resource.data.lat is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng is number
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && (!request.resource.data.keys().hasAny(['displayName'])
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 80));
      allow delete: if isSelf(userId);
    }

    /** Trailhead 공개 목록 — CF 전환 전까지 클라이언트도 listing 유지 */
    match /openTrailListings/{trailId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.trailId == trailId
        && request.resource.data.keys().hasAll(['publicationId'])
        && request.resource.data.publicationId is string
        && request.resource.data.publicationId.size() > 0;
      allow update: if isSignedIn()
        && (
          resource.data.hostUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['riderCount', 'updatedAt'])
        );
      allow delete: if isSignedIn();
    }

    /** Trail 라이브 인스턴스 메타 (`default` 는 허브 전용·문서 없음) */
    match /trails/{trailId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && trailId != 'default'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.displayNumber is int
        && request.resource.data.displayNumber >= 1
        && request.resource.data.displayNumber <= 999
        && request.resource.data.status == 'open'
        && request.resource.data.visibility in ['open', 'private']
        && trailOpenVisibilityValid(request.resource.data)
        && request.resource.data.keys().hasAll([
          'hostUid', 'displayNumber', 'status', 'visibility', 'createdAt', 'lastActivityAt'
        ]);
      allow update: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.displayNumber == resource.data.displayNumber
        && request.resource.data.status in ['open', 'closed']
        && request.resource.data.visibility in ['open', 'private']
        && trailOpenVisibilityValid(request.resource.data);
      allow delete: if false;
    }

    /** Trail presence — `rooms/` 레거시는 아래 read-only */
    match /trails/{trailId}/members/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId) && trailParticipantWriteAllowed(trailId);
      allow delete: if isSelf(userId);
    }

    /**
     * `livePublicationRides` collection group 목록(주행 중 Trail 탐색).
     */
    match /{path=**}/livePublicationRides/{userId} {
      allow read: if isSignedIn();
    }

    /** Trail: 출판 주행 진행률만 공유(geometry 미저장). */
    match /trails/{trailId}/livePublicationRides/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(userId)
        && trailParticipantWriteAllowed(trailId)
        && request.resource.data.keys().hasAll(['publicationId', 'progressRatio', 'lastSeenAt'])
        && request.resource.data.keys().hasOnly(['publicationId', 'progressRatio', 'lastSeenAt', 'displayName'])
        && request.resource.data.publicationId is string
        && request.resource.data.publicationId.size() >= 1
        && request.resource.data.publicationId.size() <= 128
        && request.resource.data.progressRatio is number
        && request.resource.data.progressRatio >= 0
        && request.resource.data.progressRatio <= 1
        && (!request.resource.data.keys().hasAny(['displayName'])
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 80));
      allow delete: if isSelf(userId);
    }

    /** @deprecated Phase 5 — `livePublicationRides` 로 이전, read-only */
    match /{path=**}/liveCourseRides/{userId} {
      allow read: if isSignedIn();
    }

    /** @deprecated Phase 5 — read-only */
    match /trails/{trailId}/liveCourseRides/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /** @deprecated `rooms/` — 마이그레이션 후 read-only(클라이언트 write 금지) */
    match /rooms/{roomId}/members/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /rooms/{roomId}/liveCourseRides/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /rides/{rideId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * 사용자가 저장한 경로(이름·출발/도착·geometry·거리/시간).
     * 본인만 read/write. update 시 소유자(userId) 변경 금지.
     * 게스트(익명)는 클라이언트 정책상 localStorage 만 사용 — 익명 uid 도 기술적으로는 허용됨.
     */
    match /savedRoutes/{routeId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.routeFingerprint is string
        && request.resource.data.routeFingerprint.size() == 64;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /config/{configId} {
      allow get: if configId == 'routeReviewers'
        && isSignedIn()
        && exists(/databases/$(database)/documents/config/routeReviewers)
        && request.auth.uid in get(/databases/$(database)/documents/config/routeReviewers).data.uids;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /publicRouteRequests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.applicantUid == request.auth.uid || isRouteReviewer());

      allow create: if isSignedIn()
        && userTierAllowsPublicRoute()
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.savedRouteId is string
        && savedRouteOwnedAndCompletedForRequest(request.resource.data.savedRouteId)
        && request.resource.data.savedRouteNameSnapshot is string
        && request.resource.data.savedRouteNameSnapshot.size() >= 1
        && request.resource.data.savedRouteNameSnapshot.size() <= 40
        && request.resource.data.publicTitle is string
        && request.resource.data.publicTitle.size() >= 1
        && request.resource.data.publicTitle.size() <= 80
        && request.resource.data.publicSummary is string
        && request.resource.data.publicSummary.size() <= 500
        && experienceTagsValidPublicRequest()
        && request.resource.data.snapshotProfile in ['cycling', 'driving', 'walking']
        && request.resource.data.snapshotDistanceMeters is number
        && request.resource.data.snapshotDurationSec is number
        && request.resource.data.snapshotStartLngLat is list
        && request.resource.data.snapshotEndLngLat is list
        && request.resource.data.geometryType == 'LineString'
        && request.resource.data.geometryCoordsJson is string
        && request.resource.data.geometryCoordsJson.size() >= 10
        && request.resource.data.geometryCoordsJson.size() <= 4800000
        && request.resource.data.routeFingerprint is string
        && request.resource.data.routeFingerprint.size() == 64
        && request.resource.data.namingPolicyAcknowledged == true
        && request.resource.data.namingPolicyVersion is string
        && request.resource.data.namingPolicyVersion.size() >= 4;

      allow update: if resource.data.status == 'pending'
        && (
          (
            isRouteReviewer()
            && request.resource.data.applicantUid == resource.data.applicantUid
            && request.resource.data.savedRouteId == resource.data.savedRouteId
            && (
              (
                request.resource.data.status == 'approved'
                && request.resource.data.reviewerUid == request.auth.uid
                && request.resource.data.createdPublicationId is string
                && request.resource.data.createdPublicationId.size() > 0
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'reviewerUid', 'reviewedAt', 'updatedAt', 'createdPublicationId'])
              )
              || (
                request.resource.data.status == 'rejected'
                && request.resource.data.reviewerUid == request.auth.uid
                && request.resource.data.rejectionReason is string
                && request.resource.data.rejectionReason.size() >= 1
                && request.resource.data.rejectionReason.size() <= 500
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'reviewerUid', 'reviewedAt', 'updatedAt', 'rejectionReason'])
              )
            )
          )
          || (
            resource.data.applicantUid == request.auth.uid
            && request.resource.data.status == 'withdrawn'
            && request.resource.data.applicantUid == resource.data.applicantUid
            && request.resource.data.savedRouteId == resource.data.savedRouteId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt', 'withdrawnAt'])
          )
        );

      allow delete: if false;
    }

    /** UGC 퍼블릭 출판 스냅샷 — `routeId` = `savedRoutes` id */
    match /routePublications/{publicationId} {
      allow read: if isSignedIn()
        || (resource.data.keys().hasAny(['status']) && resource.data.status == 'published');
      allow create: if isRouteReviewer()
        && request.resource.data.routeId is string
        && request.resource.data.routeId.size() > 0
        && request.resource.data.publicTitle is string
        && request.resource.data.publicTitle.size() >= 1
        && request.resource.data.publicTitle.size() <= 80
        && request.resource.data.status == 'published'
        && request.resource.data.routeFingerprint is string
        && request.resource.data.routeFingerprint.size() == 64
        && request.resource.data.geometryCoordsJson is string
        && request.resource.data.geometryCoordsJson.size() >= 10;
      allow update: if isSignedIn()
        && resource.data.status == 'published'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['presenceEnabled', 'updatedAt'])
        && request.resource.data.presenceEnabled == true;
      allow delete: if false;
    }

    match /publicationSessions/{publicationId}/members/{userId} {
      allow read: if isSignedIn() && isPublicationSharedPresenceAllowed(publicationId);
      allow create, update: if isSelf(userId) && isPublicationSharedPresenceAllowed(publicationId);
      allow delete: if isSelf(userId) && isPublicationSharedPresenceAllowed(publicationId);
    }

    /** 월드 활동 집계(선택). 콘솔/CF로만 수정 — 클라이언트 write 금지. 로그인 사용자 읽기. */
    match /appMeta/{docId} {
      allow read: if isSignedIn() && docId == 'worldPresence';
      allow write: if false;
    }

    /** Activity World — publication 단위 aggregate. 읽기만 클라이언트, 쓰기는 Functions. */
    match /routeActivity/{publicationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /** World Activity Presence — publication 1 dot. 읽기만 클라이언트, 쓰기는 Functions. */
    match /publicationPresence/{publicationId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /worldActivity/{tileId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /** Route Token 원장 — Functions 전용 쓰기. 본인 ledger 읽기만 허용. */
    match /routeTokenLedger/{entryId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    /** 경제 수치 — 로그인 읽기, 쓰기는 콘솔·Functions(Admin SDK). */
    match /config/routeTokenEconomy {
      allow read: if isSignedIn();
      allow write: if false;
    }

    /** Stripe Webhook 멱등 — Functions(Admin SDK) 전용 */
    match /billingProcessedEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
