# Route Token harness — Emulator 전용 (git 추적). 개인 .env.local 을 대체하지 않는다.
VITE_USE_EMULATOR=1
VITE_FIREBASE_PROJECT_ID=demo-rtw-route-token
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
VITE_FUNCTIONS_REGION=asia-northeast3
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-rtw-route-token.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-rtw-route-token.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:route_token_harness
# 지도 타일(선택). Directions 는 Functions Emulator 경유.
VITE_MAPBOX_ACCESS_TOKEN=pk.route-token-harness-placeholder
