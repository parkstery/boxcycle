# 로컬 Firebase Functions Emulator — `npm run dev:emulator` 와 함께 사용
# 터미널 1: npm run emulators (저장소 루트)
# 터미널 2: npm run dev:emulator -w boxcycle-web  (Vite 5002, Emulator 5001)
VITE_USE_EMULATOR=1
VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# Mock Firebase config for emulator (not real credentials, emulator ignores them)
# Must match `firebase emulators:exec --project boxcycle-dc2df` used by e2e launchers.
VITE_FIREBASE_API_KEY=fake-api-key-for-emulator
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=boxcycle-dc2df
VITE_FIREBASE_STORAGE_BUCKET=boxcycle-dc2df.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=boxcycle-dc2df-default-rtdb

# Mock Mapbox token for emulator (map tiles may fail, but app should render)
VITE_MAPBOX_ACCESS_TOKEN=pk.fake-token-for-emulator-testing
