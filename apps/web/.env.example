# Firebase 웹 앱 설정 — Firebase Console > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성
# 이 파일을 복사:  apps/web/.env  (루트가 아님)
# https://console.firebase.google.com/
#
# 게스트(익명): Console > Authentication > Sign-in method > 익명(Anonymous) 사용 설정
# 앱에서는 페이지 진입 시 자동 익명 로그인을 하지 않으며, 사용자가 「게스트로 시작」을 눌렀을 때만 익명 계정이 생성됩니다.

# Firebase Realtime Database (P1 peer motion 5Hz). 미설정 시 `{projectId}-default-rtdb.firebaseio.com` 자동 사용.
# Console > Realtime Database > 데이터베이스 만들기 후 URL 복사
# VITE_FIREBASE_DATABASE_URL=https://boxcycle-dc2df-default-rtdb.firebaseio.com

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 지도(Mapbox GL 타일·스타일). Directions 경로 계산은 서버(Callable getMapboxDirections)만 사용 — 클라이언트에 secret 불필요.
VITE_MAPBOX_ACCESS_TOKEN=

# Mapillary(거리뷰·촬영 시퀀스 커버리지). 없으면 맵 뷰 시트에서 Mapillary 관련 옵션 비활성.
# 발급: https://www.mapillary.com/dashboard/developers → Client token
VITE_MAPILLARY_CLIENT_TOKEN=
#
# Graph API(거리뷰 이미지 검색)는 기본적으로 Cloud Functions `getMapillaryImages` 프록시 경유(CORS·429 완화).
# Functions 시크릿: MAPILLARY_ACCESS_TOKEN (위 Client token 과 동일 값 가능)
#   firebase functions:secrets:set MAPILLARY_ACCESS_TOKEN
# (임시) 브라우저에서 graph.mapillary.com 직접 호출 — localhost CORS 디버그용만
# VITE_MAPILLARY_DIRECT=1

# Cloud Functions 리전(선택). 기본 asia-northeast3 — functions/src/index.ts 의 onCall region 과 맞출 것.
# VITE_FUNCTIONS_REGION=asia-northeast3

# 로컬 Functions Emulator — Vite만 켜면 getDistanceAutoRoute 가 프로덕션(배포본)을 호출한다.
# 터미널 1(루트): npm run emulators
# 터미널 2: npm run dev:emulator -w boxcycle-web  → http://localhost:5002 (Emulator 는 5001)
# apps/web/.env.emulator 가 VITE_USE_EMULATOR=1 을 설정한다. 기본 .env 의 Firebase·Mapbox 토큰은 그대로 필요.
# VITE_USE_EMULATOR=1
# VITE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001

# (임시 우회) Directions 호출을 Cloud Functions Callable 대신 브라우저에서 Mapbox REST 로 직접 호출.
#   - Cloud Functions Gen2 의 Cloud Run Invoker 권한 이슈로 CORS preflight 가 막힐 때만 임시로 켤 것.
#   - 켜면 VITE_MAPBOX_ACCESS_TOKEN(pk.) 가 네트워크 탭에 노출됩니다. Mapbox 콘솔에서 토큰에 URL 제한을 거세요.
#   - Firebase 정상화 후에는 이 줄을 지워서 원복하십시오.
# VITE_DIRECTIONS_DIRECT=1

# DEV: Activity World pulse dot — Mapbox circle 스타일 하드코딩(#ff0000 r12). 기본 DEV on, 끄려면 false.
# VITE_DEBUG_ACTIVITY_PULSE_DOT_STYLE=false

# Map 표현 계층 복구 (260527) — unset = Phase D (MapView). A/B/C 명시 시에만 격리 디버그
# Phase A–C 에서 publicationPresenceWorldMapEnabled=false 는 정상 (DebugWorldLightMap 경로)
# VITE_MAP_DEBUG_PHASE=A
# VITE_MAP_DEBUG_PHASE=B
# VITE_MAP_DEBUG_PHASE=C
# Phase D: LOD 끄고 raw dot 직접
# VITE_MAP_DEBUG_SKIP_LOD=true
# Activity World LOD 통계 패널 — 켜면 env Phase B/C 는 catalog(E2E) 로 강등
# VITE_SHOW_ACTIVITY_LOD_DEBUG=true
