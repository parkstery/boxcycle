# Firebase 웹 앱 설정 — Firebase Console > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성
# 이 파일을 복사:  apps/web/.env  (루트가 아님)
# https://console.firebase.google.com/
#
# 게스트(익명) 주행: Console > Authentication > Sign-in method > 익명(Anonymous) 사용 설정

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 지도(Mapbox GL). 레거시 config.local.js 의 pk. 토큰과 동일 값을 쓸 수 있음.
# 비우면 지도 영역에 안내만 표시됩니다. 배포·공개 환경에서는 Cloud Functions 프록시 권장.
VITE_MAPBOX_ACCESS_TOKEN=
