{
  "name": "boxcycle-functions",
  "private": true,
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "admin:promote-saved-route": "npm run build && node lib/cliPromoteSavedRoute.js",
    "admin:migrate-rooms-to-trails": "npm run build && node lib/cliMigrateRoomsToTrails.js",
    "admin:purge-discardable-rides": "npm run build && node lib/cliPurgeDiscardableRides.js",
    "admin:audit-terminology": "npm run build && node lib/cliAuditTerminology.js",
    "admin:backfill-rides-terminology": "npm run build && node lib/cliBackfillRidesTerminology.js",
    "admin:backfill-route-publications": "npm run build && node lib/cliBackfillRoutePublications.js",
    "admin:backfill-course-metadata": "npm run build && node lib/cliBackfillCourseMetadata.js",
    "admin:discard-basic-hub-courses": "npm run build && node lib/cliDiscardBasicHubCourses.js",
    "admin:backfill-route-activity": "npm run build && node lib/cliBackfillRouteActivity.js",
    "admin:purge-ride-legacy-fields": "npm run build && node lib/cliPurgeRideLegacyFields.js",
    "admin:migrate-live-publication-rides": "npm run build && node lib/cliMigrateLivePublicationRides.js",
    "admin:archive-courses": "npm run build && node lib/cliArchiveCourses.js",
    "admin:migrate-publication-sessions": "npm run build && node lib/cliMigratePublicationSessions.js",
    "admin:phase7-terminology-purge": "npm run build && node lib/cliPhase7TerminologyPurge.js"
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "typescript": "~5.9.3"
  }
}
