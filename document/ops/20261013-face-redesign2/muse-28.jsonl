헤더 한 행 안에 absolute. 없으면 검색이 전체 가용폭. */\r\n406: .oc-modal[aria-label=\"입문 경로\"] .oc-modal__sortbar {\r\n407:   position: absolute;\r\n408:   top: 0;\r\n409:   right: 2.4rem;\r\n410:   height: 3rem;\r\n411:   margin: 0;\r\n412:   display: flex;\r\n413:   align-items: center;\r\n414:   justify-content: flex-end;\r\n415:   white-space: nowrap;\r\n416: }\r\n417: \r\n418: .oc-modal[aria-label=\"입문 경로\"]:has(.oc-modal__sortbar) .oc-modal__search {\r\n419:   margin-right: 6.5rem;\r\n420: }\r\n421: \r\n422: /* 3. 카드 반복을 행 구분선·gap 0으로 정리. 이번 입문 선택행은 min 44px 유지\r\n423:    (32px 예외는 Chief 지정 내 경로/퍼블릭만). 전체 텍스트·수단거리·활동 배지 보존. */\r\n424: .oc-modal[aria-label=\"입문 경로\"] .oc-modal__list {\r\n425:   gap: 0;\r\n426:   border-top: 1px solid #E2E8F0;\r\n427: }\r\n428: \r\n429: .oc-modal[aria-label=\"입문 경로\"] .oc-modal__item {\r\n430:   border: none;\r\n431:   border-bottom: 1px solid #E2E8F0;\r\n432:   border-radius: 0;\r\n433:   background: transparent;\r\n434:   box-sizing: border-box;\r\n435:   min-height: 44px;\r\n436:   height: auto;\r\n437:   padding: 2px 0.55rem;\r\n438: }\r\n439: \r\n440: .oc-modal[aria-label=\"입문 경로\"] .oc-modal__item:hover:not(:disabled) {\r\n441:   background: #EFF6FF;\r\n442: }\r\n443: \r\n444: .oc-modal[aria-label=\"입문 경로\"] .oc-modal__item.is-selected {\r\n445:   background: #EFF6FF;\r\n446:   box-shadow: inset 3px 0 0 0 #2563EB;\r\n447: }\r\n448: \r\n449: .oc-modal[aria-label=\"입문 경로\"] .oc-modal__item-name {\r\n450:   line-height: 1.2;\r\n451:   overflow-wrap: anywhere;\r\n452:   word-break: break-word;\r\n453: }\r\n454: \r\n455: .oc-modal[aria-label=\"입문 경로\"] .oc-modal__item-sub {\r\n456:   flex-wrap: wrap;\r\n457:   row-gap: 0.1rem;\r\n458:   margin-top: 1px;\r\n459:   line-height: 1.2;\r\n460: }\r\n461: \r\n462: .oc-modal[aria-label=\"입문 경로\"] .oc-modal__item-publisher {\r\n463:   flex-shrink: 1;\r\n464:   min-width: 0;\r\n465:   white-space: normal;\r\n466:   overflow-wrap: anywhere;\r\n467:   word-break: break-word;\r\n468:   text-align: right;\r