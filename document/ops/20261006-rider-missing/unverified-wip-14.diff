+/** e2e·DEV 계측 — 레이어 존재·부착·로드 상태·WebGL 유실 */
+export function probeRiderPreservedLayer(map: MapboxMap): {
+  layerExists: boolean;
+  layerIndex: number;
+  layerCount: number;
+  attached: boolean;
+  loadState: string | null;
+  loadError: string | null;
+  hasRig: boolean;
+  hasSpec: boolean;
+  webglLost: boolean | null;
+} {
+  let layers: ReadonlyArray<{ id: string }> = [];
+  try {
+    layers = map.getStyle()?.layers ?? [];
+  } catch {
+    layers = [];
+  }
+  const layerIndex = layers.findIndex((l) => l.id === PRESERVED_RIDER_CUSTOM_LAYER_ID);
+  const layer = layerByMap.get(map);
+  const debug = layer?.getDebugState() ?? null;
+  let webglLost: boolean | null = null;
+  try {
+    const canvas = map.getCanvas() as HTMLCanvasElement & { isContextLost?: () => boolean };
+    webglLost = typeof canvas.isContextLost === "function" ? canvas.isContextLost() : null;
+  } catch {
+    webglLost = null;
+  }
+  return {
+    layerExists: layerIndex >= 0,
+    layerIndex,
+    layerCount: layers.length,
+    attached: layer?.isAttached() === true,
+    loadState: debug?.loadState ?? null,
+    loadError: debug?.loadError ?? null,
+    hasRig: debug?.hasRig ?? false,
+    hasSpec: debug?.hasSpec ?? false,
+    webglLost,
+  };
+}
+
 export function syncRiderPreservedModels(map: MapboxMap, specs: readonly RiderGlbModelSpec[]): void {
