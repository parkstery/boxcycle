{
  "name": "boxcycle",
  "private": true,
  "version": "1.0.0",
  "description": "문서 작성은 `document/260509-BOXCYCLE-문서-생성-및-수정-지침.md`를 따른다.",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w boxcycle-web --",
    "dev:localhost": "npm run dev:localhost -w boxcycle-web --",
    "build": "npm run build -w boxcycle-web",
    "preview": "npm run preview -w boxcycle-web",
    "lint": "npm run lint -w boxcycle-web",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:course-activity-functions": "firebase deploy --only \"functions:courseActivityOnLiveCourseRideWritten,functions:courseActivityScheduledReconcile\"",
    "deploy:publication-presence": "npm run build && firebase deploy --only firestore:indexes,firestore:rules && firebase deploy --only \"functions:courseActivityOnLiveCourseRideWritten,functions:courseActivityScheduledReconcile\" && firebase deploy --only hosting",
    "deploy:firestore": "firebase deploy --only firestore",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:web": "npm run build && firebase deploy --only hosting,firestore",
    "deploy:app": "npm run build && firebase deploy --only hosting,firestore,functions",
    "admin:promote-saved-route": "npm --prefix functions run admin:promote-saved-route --",
    "admin:migrate-rooms-to-trails": "npm --prefix functions run admin:migrate-rooms-to-trails --",
    "admin:migrate-route-catalog-paths": "npm --prefix functions run admin:migrate-route-catalog-paths --",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parkstery/boxcycle.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/parkstery/boxcycle/issues"
  },
  "homepage": "https://github.com/parkstery/boxcycle#readme"
}
