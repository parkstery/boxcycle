#!/bin/sh
# RTW pre-commit 게이트 — 스테이징된 소스 파일에 lint만 (빠름).
# 타입체크는 무겁다(≈12s) → pre-push 로 미룬다.
# 우회: git commit --no-verify (예외 상황 한정, 문서 §자동화 참고)
#
# 활성화: git config core.hooksPath githooks  (README/문서에 안내, clone 후 1회)

set -e

# 스테이징된(추가·수정) JS/TS 파일만 — 워크스페이스별로 나눔
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mjs)$' || true)

if [ -z "$staged" ]; then
  exit 0
fi

web_files=$(echo "$staged" | grep '^apps/web/' | sed 's|^apps/web/||' || true)
fn_files=$(echo "$staged" | grep '^functions/' | sed 's|^functions/||' || true)

fail=0

# eslint 설정이 있는 워크스페이스만 검사한다.
# `functions/` 는 eslint 설정을 둔 적이 없어, 설정 유무를 안 보면 functions/*.ts 를
# 건드리는 모든 커밋이 "couldn't find an eslint.config" 로 막힌다(타입체크는 pre-push 담당).
has_eslint_config() {
  [ -f "$1/eslint.config.js" ] || [ -f "$1/eslint.config.mjs" ] || [ -f "$1/eslint.config.cjs" ]
}

if [ -n "$web_files" ]; then
  if has_eslint_config apps/web; then
    echo "[pre-commit] eslint apps/web ($(echo "$web_files" | wc -l | tr -d ' ') files)"
    ( cd apps/web && echo "$web_files" | xargs npx eslint ) || fail=1
  else
    echo "[pre-commit] apps/web — eslint 설정 없음, 건너뜀"
  fi
fi

if [ -n "$fn_files" ]; then
  if has_eslint_config functions; then
    echo "[pre-commit] eslint functions ($(echo "$fn_files" | wc -l | tr -d ' ') files)"
    ( cd functions && echo "$fn_files" | xargs npx eslint ) || fail=1
  else
    echo "[pre-commit] functions — eslint 설정 없음, 건너뜀"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "[pre-commit] lint 실패 — 고치고 다시 커밋하세요."
  echo "             정말 급하면: git commit --no-verify (예외)"
  exit 1
fi

exit 0
